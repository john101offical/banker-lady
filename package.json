{
  "name": "banker-lady",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Banker Lady: an AI banker for partner, susu and tanda savings circles, built on PayPal.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "test": "tsx server/selftest.ts && tsx server/selftest-openrouter.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@7.3.8",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
