# Leave everything empty to run with simulated PayPal and the offline banker.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# A sandbox personal account that receives invoices and payouts for every member
SANDBOX_BUYER_EMAIL=
# Optional per-member sandbox accounts: id=email, comma separated
# Member ids: joyce, kezia, andre, devon, pauline, marcia
MEMBER_EMAILS=

# The AI banker through OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional: anthropic/claude-sonnet-5.5 (default) or anthropic/claude-haiku-5.5 for faster, cheaper replies
OPENROUTER_MODEL=

# Optional alternative to OpenRouter: call Claude directly (console.anthropic.com).
# Only used when OPENROUTER_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional
PORT=8787
PAYPAL_POLL_SECONDS=8
